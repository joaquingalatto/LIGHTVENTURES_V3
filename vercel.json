{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "functions": {
    "server.js": {
      "includeFiles": "**/*"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)\\.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
